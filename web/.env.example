# =====================================================================
#  NÃO PREENCHA ESTE ARQUIVO. Ele é versionado — tudo que for escrito
#  aqui vai parar no GitHub.
#
#      cp web/.env.example web/.env.local
#
#  Os valores reais vão no .env.local, que é ignorado pelo git.
# =====================================================================

# Connection string POOLED do Neon — a que tem "-pooler" no host.
# Painel do Neon > Connection Details > Connection pooling ligado.
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo de assinatura do cookie de sessão (fase 5).
# Gerar com: openssl rand -base64 32
JWT_SECRET=""
